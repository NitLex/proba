# Скопируй в .env и заполни. Файл .env в git НЕ попадает.

# LeadGid
LEADGID_TOKEN=
LEADGID_OFFER_ID=7397

# Яндекс.Директ (OAuth access_token — длинная строка, не ClientID)
YANDEX_DIRECT_TOKEN=
YANDEX_DIRECT_LOGIN=

# Live Wordstat (Yandex Cloud Search API v2)
# Ключ из AI Studio / Search API + folder id каталога
YANDEX_CLOUD_API_KEY=
YANDEX_CLOUD_FOLDER_ID=
# WORDSTAT_REGIONS=225
# WORDSTAT_MAX_SEEDS=8

# Cursor Cloud Agents (автозапуск субагентов из оркестратора)
# Dashboard → Cloud Agents / API Keys
CURSOR_API_KEY=
CURSOR_REPO_URL=https://github.com/NitLex/proba
CURSOR_STARTING_REF=main
CURSOR_AUTO_CREATE_PR=false
# CURSOR_AGENT_MODEL=

# Прод-трекер (кампании/офферы/постбеки). Оркестратор — только локально.
ARBTRACK_PUBLIC_URL=https://trekerarbitrag.ru
ARBTRACK_USERNAME=
ARBTRACK_PASSWORD=

# Бюджет теста
DAILY_BUDGET_RUB=5000
TARGET_ROI_PCT=30
MAX_CPC_RUB=7

# ArbTrack
PORT=3001
