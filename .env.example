# Скопируй в .env и заполни. Файл .env в git НЕ попадает.

# LeadGid
LEADGID_TOKEN=
LEADGID_OFFER_ID=7397

# Яндекс.Директ (OAuth access_token — длинная строка, не ClientID)
YANDEX_DIRECT_TOKEN=
YANDEX_DIRECT_LOGIN=

# Публичный URL трекера (для постбека в LeadGid и кликовых ссылок)
# Пример: https://track.example.com  или  http://IP:3001
ARBTRACK_PUBLIC_URL=http://localhost:3001

# Бюджет теста
DAILY_BUDGET_RUB=5000
TARGET_ROI_PCT=30
MAX_CPC_RUB=7

# ArbTrack
PORT=3001
