# Скопируй в .env / SECRETS.env и заполни. В git НЕ попадает.

# LeadGid
LEADGID_TOKEN=
LEADGID_OFFER_ID=7397

# Яндекс.Директ (OAuth access_token — длинная строка, не ClientID)
YANDEX_DIRECT_TOKEN=
YANDEX_DIRECT_LOGIN=

# Live Wordstat (Yandex Cloud Search API v2)
YANDEX_CLOUD_API_KEY=
YANDEX_CLOUD_FOLDER_ID=
# WORDSTAT_REGIONS=225
# WORDSTAT_MAX_SEEDS=8

# Cursor Cloud Agents (опционально)
CURSOR_API_KEY=
CURSOR_REPO_URL=https://github.com/NitLex/proba
CURSOR_STARTING_REF=main
CURSOR_AUTO_CREATE_PR=false

# Креативы: по умолчанию Cursor креатив-агент (GenerateImage + референсы)
# agent | reference | auto | yandex_art | openai | replicate | none
IMAGE_PROVIDER=agent
# IMAGE_GEN_LIMIT=2

# Legacy (не нужно для agent):
# IMAGE_PROVIDER=yandex_art
# YANDEX_ART_MODEL=yandex-art/latest
# IMAGE_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_RELAY_URL=http://127.0.0.1:8787
# OPENAI_RELAY_SECRET=long-random
# OPENAI_HTTP_PROXY=http://user:pass@eu-proxy:8080
# OPENAI_ALLOW_YANDEX_FALLBACK=0



# Telegram ops alerts (опционально)
# Создай бота у @BotFather, пропиши токен. В профиле — chat_id после /start.
# TELEGRAM_BOT_TOKEN=
# If api.telegram.org times out on the VPS, pin a working DC IP:
# TELEGRAM_API_IP=149.154.167.220
# ALERTS_INTERVAL_MIN=30

# Режим хоста: full | orchestrator | tracker
# orkestr.online → orchestrator; trekerarbitrag.ru → tracker (или full)
APP_MODE=full
ORCHESTRATOR_PUBLIC_URL=https://orkestr.online

# Прод-трекер (клики/постбэки всегда сюда)
ARBTRACK_PUBLIC_URL=https://trekerarbitrag.ru
# На трекере: local. На отдельном оркестраторе: remote + логин трекера:
PIPELINE_TRACKER_MODE=local
# ARBTRACK_USERNAME=
# ARBTRACK_PASSWORD=

# Смысловой домен в объявлении (вместо trekerarbitrag.ru).
# DNS A → IP VPS + nginx server_name + SSL, иначе клики/модерация упадут.
AD_DISPLAY_DOMAIN=finexpert24.online
# AD_DISPLAY_DOMAIN_TRAVEL=paytravel.ru
# AD_DISPLAY_DOMAIN_SERVICES=payservices.ru
# BRAND_CLICK_DOMAIN=finexpert24.online

# Бюджет теста
DAILY_BUDGET_RUB=5000
TARGET_ROI_PCT=30
MAX_CPC_RUB=7

# Яндекс.Метрика (опционально — дефолт для Pipeline / Direct CounterIds)
# YANDEX_METRIKA_COUNTER_ID=
# YANDEX_METRIKA_SOFT_GOAL_ID=
# YANDEX_METRIKA_HARD_GOAL_ID=

PORT=3001
