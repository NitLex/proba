# Скопируй в .env / SECRETS.env и заполни. Эти файлы в git НЕ попадают.

# Яндекс.Директ (OAuth access_token — длинная строка, не ClientID)
YANDEX_DIRECT_TOKEN=
YANDEX_DIRECT_LOGIN=

# Прод-трекер
ARBTRACK_PUBLIC_URL=https://trekerarbitrag.ru

# Бюджет теста
DAILY_BUDGET_RUB=5000
MAX_CPC_RUB=5

# ArbTrack
PORT=3001
